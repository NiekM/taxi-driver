encode : Eq a => {xs : List a} -> List (a, Nat)
encode [] = []
encode [4] = [(4, 1)]
encode [3,3] = [(3,2)]
encode [3,3,3] = [(3,3)]
encode [3,4] = [(3,1),(4,1)]
encode [3,3,4] = [(3,2),(4,1)]
encode [2,3,3,4] = [(2,1),(3,2),(4,1)]
encode [1,2,3,3,4] = [(1,1),(2,1),(3,2),(4,1)]
encode [1,1,2,3,3,4] = [(1,2),(2,1),(3,2),(4,1)]
