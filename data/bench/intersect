intersect : Eq a => {xs : List a, ys : List a} -> List a
intersect [] [] = []
intersect [] [1] = []
intersect [] [1, 1] = []
intersect [] [1, 2] = []
intersect [1] [] = []
intersect [1] [1] = [1]
intersect [2] [1] = []
intersect [] [2, 1] = []
intersect [1, 2] [] = []
intersect [1, 1] [] = []
intersect [1, 1] [1] = [1, 1]
intersect [1] [1, 1] = [1]
intersect [1] [2, 1] = [1]
intersect [1, 1] [2, 1] = [1, 1]
intersect [1, 2] [3] = []
intersect [1, 2] [2] = [2]
