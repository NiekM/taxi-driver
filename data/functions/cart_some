cart_some : {xs : List (List a)} -> Maybe (List (Some a))
cart_some []              = Nothing
cart_some [[]]            = Just []
cart_some [[5]]           = Just [Cons (5, Nothing)]
cart_some [[4,5]]         = Just [Cons (4, Nothing),Cons (5, Nothing)]
cart_some [[1,2,3]]       = Just [Cons (1, Nothing),Cons (2, Nothing),Cons (3, Nothing)]
cart_some [[],[]]         = Just []
cart_some [[1],[]]        = Just []
cart_some [[1,2],[]]      = Just []
cart_some [[1,2,3],[]]    = Just []
cart_some [[],[4]]        = Just []
cart_some [[1],[4]]       = Just [Cons (1, Just (Cons (4, Nothing)))]
cart_some [[1,2],[4]]     = Just [Cons (1, Just (Cons (4, Nothing))),Cons (2, Just (Cons (4, Nothing)))]
cart_some [[1,2,3],[4]]   = Just [Cons (1, Just (Cons (4, Nothing))),Cons (2, Just (Cons (4, Nothing))),Cons (3, Just (Cons (4, Nothing)))]
cart_some [[],[4,5]]      = Just []
cart_some [[1],[4,5]]     = Just [Cons (1, Just (Cons (4, Nothing))),Cons (1, Just (Cons (5, Nothing)))]
cart_some [[1,2],[4,5]]   = Just [Cons (1, Just (Cons (4, Nothing))),Cons (1, Just (Cons (5, Nothing))),Cons (2, Just (Cons (4, Nothing))),Cons (2, Just (Cons (5, Nothing)))]
cart_some [[1,2,3],[4,5]] = Just [Cons (1, Just (Cons (4, Nothing))),Cons (1, Just (Cons (5, Nothing))),Cons (2, Just (Cons (4, Nothing))),Cons (2, Just (Cons (5, Nothing))),Cons (3, Just (Cons (4, Nothing))),Cons (3, Just (Cons (5, Nothing)))]
cart_some [[],[2],[]]     = Just []
cart_some [[1],[2],[]]    = Just []
