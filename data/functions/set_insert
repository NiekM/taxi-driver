set_insert : Ord a => {x : a, xs : List a} -> List a
set_insert 2 [] = [2]
set_insert 2 [1] = [1, 2]
set_insert 2 [5] = [2, 5]
set_insert 2 [2] = [2]
set_insert 2 [1, 5] = [1, 2, 5]
set_insert 2 [3, 5] = [2, 3, 5]
set_insert 2 [0, 1] = [0, 1, 2]
set_insert 2 [1, 2] = [1, 2]
set_insert 2 [2, 3] = [2, 3]
